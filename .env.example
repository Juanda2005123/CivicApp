# VIGIA Environment Variables
# Obtener estos valores desde el Dashboard de Supabase: Project Settings -> API
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_DB_PASSWORD=
# Solo para tool/seed/seed.mjs: contraseña común de los usuarios de demostración. La app nunca la lee.
SEED_DEMO_PASSWORD=

# Notificaciones push (HU-24). La llave de servicio de Firebase NO va aquí ni en el repo:
# guárdala en ~/.config/vigia/fcm-service-account.json (la usan tool/push/*.sh) y, para el
# servidor, como secreto de la Edge Function: supabase secrets set FCM_SERVICE_ACCOUNT=...
# Opcional: otra ruta para la llave de los scripts de prueba.
# FCM_SERVICE_ACCOUNT=/ruta/a/fcm-service-account.json
